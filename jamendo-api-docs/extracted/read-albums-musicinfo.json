{
    "operationId": "getAlbumsMusicInfo",
    "method": "GET",
    "path": "/albums/musicinfo",
    "authType": "apikey",
    "summary": "Retrieve album tags, descriptions and zip download availability",
    "description": "Returns the list of tags for each album together with its HTML description and the new 'zip_allowed' boolean indicating whether the album can be offered for download. Starting April 2022, the 'zip' field will be an empty string when 'zip_allowed' is false. This endpoint behaves like the parent '/albums' method but adds the optional 'tag' filter (single tag only).",
    "parameters": [
        {
            "name": "client_id",
            "in": "query",
            "required": true,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "A Client Id provided by devportal.jamendo.com."
        },
        {
            "name": "format",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": ["xml", "json", "jsonpretty"],
            "defaultValue": null,
            "description": "The results formatting type."
        },
        {
            "name": "callback",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Wraps the JSON response in a callback function (JSONP). Only works with json format and GET requests."
        },
        {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "enumValues": null,
            "defaultValue": null,
            "description": "The position to start returning results from."
        },
        {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Maximum number of results to return. Default 10, max 200. 'all' still limited to 200."
        },
        {
            "name": "order",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": [
                "name",
                "id",
                "releasedate",
                "artist_id",
                "artist_name",
                "popularity_total",
                "popularity_month",
                "popularity_week"
            ],
            "defaultValue": null,
            "description": "Sort results by given field(s). Append _asc or _desc to specify direction. Certain popularity fields default to desc."
        },
        {
            "name": "fullcount",
            "in": "query",
            "required": false,
            "type": "boolean",
            "enumValues": null,
            "defaultValue": null,
            "description": "If true, adds 'results_fullcount' header with total rows ignoring limit/offset. Use sparingly due to performance impact."
        },
        {
            "name": "id",
            "in": "query",
            "required": false,
            "type": "integer",
            "enumValues": null,
            "defaultValue": null,
            "description": "One or more album IDs (comma‑separated)."
        },
        {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Album name."
        },
        {
            "name": "namesearch",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Search an album by name (partial match)."
        },
        {
            "name": "artist_id",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "One or more artist IDs (comma‑separated)."
        },
        {
            "name": "artist_name",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Artist name."
        },
        {
            "name": "datebetween",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Released between dates; format 'yyyy-mm-dd_yyyy-mm-dd'."
        },
        {
            "name": "imagesize",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": [
                "25",
                "35",
                "50",
                "55",
                "60",
                "65",
                "70",
                "75",
                "85",
                "100",
                "130",
                "150",
                "200",
                "300",
                "400",
                "500",
                "600"
            ],
            "defaultValue": null,
            "description": "Cover image size in pixels."
        },
        {
            "name": "audioformat",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": ["mp32"],
            "defaultValue": null,
            "description": "Audio format for fileurl; currently only mp32 (mp3 192kbps)."
        },
        {
            "name": "type",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": ["single", "album"],
            "defaultValue": null,
            "description": "Filter by release type: single or album."
        },
        {
            "name": "tag",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Filter albums by a single tag. Results are ordered by relevance unless another order is specified."
        }
    ],
    "requestBody": [],
    "responseFields": [],
    "notes": [
        "The 'zip_allowed' boolean indicates if the album can be offered for download.",
        "When 'zip_allowed' is false, the 'zip' field will be returned as an empty string (effective from April 2022).",
        "Only a single tag can be supplied via the 'tag' parameter; multiple tags are not supported."
    ]
}
