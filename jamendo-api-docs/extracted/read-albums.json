            "in": "query",
            "required": false,
            "type": "array",
            "itemType": "string",
            "enumValues": [
                "name",
                "id",
                "releasedate",
                "artist_id",
                "artist_name",
                "popularity_total",
                "popularity_month",
                "popularity_week"
            ],
            "defaultValue": null,
            "description": "Sort results by the queried field(s). Append _asc or _desc to specify direction (default asc). Popularity fields default to desc."
        },
        {
            "name": "fullcount",
            "in": "query",
