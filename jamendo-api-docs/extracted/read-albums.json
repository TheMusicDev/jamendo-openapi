        },
        {
            "name": "format",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": ["xml", "json", "jsonpretty"],
            "defaultValue": null,
            "description": "The results formatting type."
        },
        {
            "name": "callback",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
