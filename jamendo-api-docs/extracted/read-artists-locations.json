{
    "operationId": "getArtistLocations",
    "method": "GET",
    "path": "/artists/locations",
    "authType": "apikey",
    "summary": "Retrieve artist geographical locations with optional filtering",
    "description": "This method returns artists' declared geographical locations (country, city, coordinates) and supports filtering by country, city, latitude/longitude pair, radius, and various artist attributes. Geographical filtering can be expressed by country name/codes, city name, or a latitude/longitude coordinate pair combined with a km radius. Use the callback parameter only with JSON format; otherwise it is ignored.",
    "parameters": [
        {
            "name": "client_id",
            "in": "query",
            "required": true,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "A Client Id provided by devportal.jamendo.com."
        },
        {
            "name": "format",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": ["xml", "json", "jsonpretty"],
            "defaultValue": null,
            "description": "The results formatting type."
        },
        {
            "name": "callback",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Wraps the JSON response in a callback function (JSONP). Only works for json format and GET requests; ignored otherwise."
        },
        {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "enumValues": null,
            "defaultValue": null,
            "description": "The position to start returning results from."
        },
        {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": "10",
            "description": "Maximum number of results to return. Default is 10, max 200. Using 'all' still caps at 200."
        },
        {
            "name": "order",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": ["name", "id", "joindate", "popularity_total", "popularity_month", "popularity_week"],
            "defaultValue": null,
            "description": "Sort results by the queried field(s). Append _asc or _desc to specify direction; _asc is default except for popularity fields which default to _desc."
        },
        {
            "name": "fullcount",
            "in": "query",
            "required": false,
            "type": "boolean",
            "enumValues": null,
            "defaultValue": null,
            "description": "If true, adds 'results_fullcount' header with total rows ignoring limit/offset. Increases response time; use only when needed."
        },
        {
            "name": "id",
            "in": "query",
            "required": false,
            "type": "integer",
            "enumValues": null,
            "defaultValue": null,
            "description": "One or more artist IDs to filter by."
        },
        {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Exact artist name."
        },
        {
            "name": "namesearch",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Search artists by name (wildcard *searchquery*)."
        },
        {
            "name": "hasimage",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": ["true", "1"],
            "defaultValue": null,
            "description": "Return only artists that have an image."
        },
        {
            "name": "datebetween",
            "in": "query",
            "required": false,
            "type": "string",
            "enumValues": null,
            "defaultValue": null,
            "description": "Filter on artist joining date. Format: yyyy-mm-dd_yyyy-mm-dd (from_to)."
