{
    "operationId": "getPlaylistTracks",
    "method": "GET",
    "path": "/playlists/tracks",
    "authType": "apikey",
    "summary": "Retrieve playlist entities together with their tracks",
    "description": "Returns playlist entities containing the list of belonging tracks. Requires a client_id and at least one of id, name, user_id, access_token or user_name. The response contains headers with status information and a results array of track objects. Note the new 'audiodownload_allowed' boolean and that 'audiodownload' may be empty when downloading is not allowed.",
    "parameters": [
        {
            "name": "client_id",
            "in": "query",
            "required": true,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "A Client Id provided by devportal.jamendo.com."
        },
        {
            "name": "format",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": ["xml", "json", "jsonpretty"],
            "defaultValue": null,
            "description": "The results formatting type."
        },
        {
            "name": "callback",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "Wrap the JSON response in a callback function (JSONP). Only works with json format and GET requests."
        },
        {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "The position to start returning results from."
        },
        {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": "10",
            "description": "Maximum number of results to return (default 10, max 200). Use 'all' to request up to 200 rows."
        },
        {
            "name": "order",
            "in": "query",
            "required": false,
            "type": "array",
            "itemType": "string",
            "enumValues": [
                "name",
                "id",
                "creationdate",
                "track_id",
                "track_name",
                "track_added_date",
                "track_position"
            ],
            "defaultValue": null,
            "description": "Sort results by field(s). Append _asc or _desc to set direction; ascending is default."
        },
        {
            "name": "fullcount",
            "in": "query",
            "required": false,
            "type": "boolean",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "If true, adds 'results_fullcount' to the header indicating total rows without limit/offset."
        },
        {
            "name": "id",
            "in": "query",
            "required": false,
            "type": "array",
            "itemType": "integer",
            "enumValues": null,
            "defaultValue": null,
            "description": "One or more playlist IDs."
        },
        {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "A playlist name."
        },
        {
            "name": "namesearch",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "Search a playlist by name (wildcard *searchquery*)."
        },
        {
            "name": "user_id",
            "in": "query",
            "required": false,
            "type": "array",
            "itemType": "integer",
            "enumValues": null,
            "defaultValue": null,
            "description": "One or more author IDs (no access token required)."
        },
        {
            "name": "access_token",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "A valid OAuth2 access token for the Jamendo user."
        },
        {
            "name": "user_name",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "One or more user names."
        },
        {
            "name": "datebetween",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "Created between dates; format 'from_to' with integer timestamps."
        },
        {
            "name": "audioformat",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": ["mp31", "mp32", "ogg", "flac"],
            "defaultValue": "mp31",
            "description": "Audio format for the 'audio' field."
        },
        {
            "name": "track_type",
            "in": "query",
            "required": false,
            "type": "array",
            "itemType": "string",
            "enumValues": ["single", "albumtrack"],
            "defaultValue": null,
            "description": "Filter tracks by type; defaults to albumtrack only."
        },
        {
            "name": "imagesize",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": [
                "25",
                "35",
                "50",
                "55",
                "60",
                "65",
                "70",
                "75",
                "85",
                "100",
                "130",
                "150",
                "200",
                "300",
                "400",
                "500",
                "600"
            ],
            "defaultValue": null,
            "description": "Cover image size in pixels."
        },
        {
            "name": "positionbetween",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": null,
            "defaultValue": null,
            "description": "Track position range in the playlist; format 'from_to' with integers."
        },
        {
            "name": "audiodlformat",
            "in": "query",
            "required": false,
            "type": "string",
            "itemType": null,
            "enumValues": ["mp31", "mp32", "ogg", "flac"],
            "defaultValue": null,
            "description": "Audio download format for the 'audiodownload' field."
        }
    ],
    "requestBody": [],
    "responseFields": [
        {
            "name": "headers.status",
            "type": "string",
            "nullable": false,
            "description": "Request status (e.g., 'success')."
        },
        {
            "name": "headers.code",
            "type": "integer",
            "nullable": false,
            "description": "Numeric status code (0 for success)."
        },
        {
            "name": "headers.error_message",
            "type": "string",
            "nullable": true,
            "description": "Error message if any."
        },
        {
            "name": "headers.warnings",
            "type": "string",
            "nullable": true,
            "description": "Warnings returned by the API."
        },
        {
            "name": "headers.results_count",
            "type": "integer",
            "nullable": false,
            "description": "Number of items returned in this page."
        },
        {
            "name": "results",
            "type": "array",
            "nullable": false,
            "description": "Array of playlist track objects; each object contains track fields such as id, name, audio, audiodownload_allowed, etc."
        }
    ],
    "notes": [
        "client_id is mandatory; additionally at least one of id, name, user_id, access_token or user_name must be provided.",
        "Authentication uses the client_id API key; OAuth2 token is optional for user‑specific data.",
        "The 'audiodownload_allowed' boolean indicates whether download URLs are available. When false, 'audiodownload' returns an empty string (from April 2022).",
        "Parameters that accept multiple values (id, user_id, track_type, order) are supplied as comma‑separated lists."
    ]
}
