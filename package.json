{
    "name": "jamendo-openapi",
    "module": "src/index.ts",
    "type": "module",
    "scripts": {
        "prepare": "lefthook install",
        "cli": "bun run src/index.ts",
        "test": "bun test",
        "check:types": "tsc --noEmit",
        "check:dead-code": "bun run fallow dead-code",
        "check:dupes": "bun run fallow dupes",
        "check:health": "bun run fallow health",
        "check:audit": "bun run fallow audit",
        "lint": "biome check .",
        "lint:fix": "biome check --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/bun": "^1.3.14",
        "fallow": "^3.17.0",
        "lefthook": "^2.1.10",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@ai-sdk/openai-compatible": "^3.0.31",
        "@mendable/firecrawl-js": "^4.32.2",
        "ai": "^7.0.67",
        "bottleneck": "^2.19.5",
        "citty": "^0.2.2",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "yaml": "^2.9.0",
        "zod": "3"
    }
}
